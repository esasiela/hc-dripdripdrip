#!/usr/bin/env bash
# Refuses commits on main. Enable with: git config core.hooksPath scripts/git-hooks
branch=$(git branch --show-current)
if [ "$branch" = "main" ]; then
  echo "pre-commit: refusing to commit on 'main' (protected)." >&2
  echo "Create a branch first, e.g.: git switch -c feat/short-desc" >&2
  exit 1
fi
